{
  "name": "storage-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "api:check": "npm run api:check --workspace apps/web",
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "test": "npm run test --workspace apps/web",
    "lint": "npm run lint --workspace apps/web && node --test tests/web/i18n-gate.test.mjs",
    "typecheck": "npm run typecheck --workspace apps/web",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@vitest/coverage-v8": "^4.1.11",
    "vitest": "^4.1.11"
  }
}
