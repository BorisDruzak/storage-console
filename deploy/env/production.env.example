# Copy outside the checkout, chmod0600; replace every CHANGE_ME value.
STORAGE_HOSTNAME=storage.example.test
APP_ORIGIN=https://storage.example.test
PROJECT_NAME=storage-control-plane
APP_RELEASE=CHANGE_ME_EXACT_GIT_SHA
API_IMAGE=storage-console-api:CHANGE_ME_EXACT_GIT_SHA
WEB_IMAGE=storage-console-web:CHANGE_ME_EXACT_GIT_SHA
POSTGRES_USER=storage_console
POSTGRES_DB=storage_console
# Generate with openssl rand -hex 32; hex avoids URL interpolation ambiguities.
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_HEX
STATE_DIR=/var/lib/storage-control-plane
BACKUP_DIR=/var/backups/storage-control-plane
TLS_CERT_FILE=/etc/storage-control-plane/tls/fullchain.pem
TLS_KEY_FILE=/etc/storage-control-plane/tls/privkey.pem
TLS_CA_FILE=/etc/storage-control-plane/tls/ca-chain.pem
AUTH_CONFIG_FILE=/etc/storage-control-plane/auth/auth.json
# Optional public directory trust bundle; when empty uses TLS_CA_FILE.
# Directory JSON ca_file must be /run/secrets/storage-console/directory-ca.pem.
DIRECTORY_CA_FILE=
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_BIND=0.0.0.0
HTTPS_PORT=443
SENTRY_DSN=

# Central inventory evidence window (seconds), allowed 1..604800; separate from heartbeat.
INVENTORY_STALE_SECONDS=7200
