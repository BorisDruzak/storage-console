APP_ENV=development
APP_LOCALE=ru-RU
APP_FALLBACK_LOCALE=en-US
APP_TIMEZONE=Asia/Yekaterinburg
MAX_INGEST_BYTES=16777216

POSTGRES_DB=storage_console
POSTGRES_USER=storage_console
POSTGRES_PASSWORD=change-me-locally

DATABASE_URL=postgresql+psycopg://storage_console:change-me-locally@postgres:5432/storage_console

SENTRY_DSN=
SONAR_HOST_URL=
SONAR_TOKEN=

# Use tests/deployment/prepare_development.py for a fresh disposable Linux fixture.
# Supply private files outside Git for a persistent development stack.
STORAGE_HOSTNAME=storage.example.test
APP_ORIGIN=https://storage.example.test:8443
AUTH_CONFIG_FILE=/etc/storage-console/auth/auth.json
TLS_CERT_FILE=/etc/storage-console/tls/fullchain.pem
TLS_KEY_FILE=/etc/storage-console/tls/privkey.pem
TLS_CA_FILE=/etc/storage-console/tls/ca.pem
DIRECTORY_CA_FILE=
WEB_PORT=8080
HTTPS_PORT=8443

# Central inventory evidence window (seconds), allowed 1..604800; separate from heartbeat.
INVENTORY_STALE_SECONDS=7200
