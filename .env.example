APP_ENV=development
APP_LOCALE=ru-RU
APP_FALLBACK_LOCALE=en-US
APP_TIMEZONE=UTC

POSTGRES_DB=storage_console
POSTGRES_USER=storage_console
POSTGRES_PASSWORD=change-me-locally

DATABASE_URL=postgresql+psycopg://storage_console:change-me-locally@postgres:5432/storage_console

SENTRY_DSN=
SONAR_HOST_URL=
SONAR_TOKEN=

# Production hostname/TLS paths are deployment-specific and must not be committed with real values.
PUBLIC_BASE_URL=http://localhost
